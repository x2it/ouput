# ============================================
# 7喵仓库 - 环境变量示例
# 复制为 .env.local 并填入真实值
# ⚠️ 严禁把真实值提交到 git（.gitignore 已排除）
# ============================================

# 服务监听端口（由 Coze 沙箱自动注入，一般无需手动设置）
# DEPLOY_RUN_PORT=5000

# --- Supabase 数据库 ---
# 项目 URL（控制台 -> Settings -> API）
COZE_SUPABASE_URL=

# 匿名密钥（public anon key，可用于 RLS 保护的读操作）
COZE_SUPABASE_ANON_KEY=

# 服务角色密钥（service_role key，绕过 RLS 用于管理端写操作）
# ⚠️ 该密钥拥有最高权限，切勿泄露、切勿提交 git
COZE_SUPABASE_SERVICE_ROLE_KEY=

# --- 管理员认证 ---
# 管理员登录密码（强烈建议设置强密码）
# 未设置时：登录接口会直接拒绝（安全默认），开发体验可临时设置
ADMIN_PASSWORD=

# 会话签名密钥（32 字节以上随机字符串，如 `openssl rand -hex 32`）
# 用于 HMAC 签名登录 token，泄露后攻击者可伪造会话
AUTH_SECRET=

# --- 对外域名（由 Coze 沙箱自动注入）---
# COZE_PROJECT_DOMAIN_DEFAULT=
